{
  "name": "markdown-pr-review",
  "version": "1.0.0",
  "description": "Chrome extension: review Markdown files in GitHub / GitHub Enterprise pull requests as rendered documents and comment on selected text.",
  "scripts": {
    "build": "node build.mjs",
    "dev": "node build.mjs --watch",
    "typecheck": "tsc",
    "test": "vitest run",
    "harness": "node build.mjs --dev --harness",
    "zip": "npm run build && cd dist && zip -qr ../markdown-pr-review.zip ."
  },
  "dependencies": {
    "diff": "^8.0.4",
    "github-markdown-css": "^5.8.1",
    "katex": "^0.18.10",
    "mermaid": "^12.2.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-markdown": "^10.1.0",
    "rehype-raw": "^7.0.0",
    "rehype-sanitize": "^6.0.0",
    "remark-frontmatter": "^5.0.0",
    "remark-gemoji": "^8.0.0",
    "remark-gfm": "^4.0.1",
    "remark-math": "^6.0.0",
    "unist-util-visit": "^5.0.0"
  },
  "devDependencies": {
    "@types/chrome": "^0.0.287",
    "@types/hast": "^3.0.4",
    "@types/mdast": "^4.0.4",
    "@types/node": "^22.20.5",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "esbuild": "^0.28.2",
    "playwright-core": "^1.49.1",
    "typescript": "^5.6.3",
    "vite": "^8.3.4",
    "vitest": "^5.0.5"
  },
  "private": true,
  "license": "MIT",
  "type": "module",
  "overrides": {
    "katex": "$katex"
  }
}
