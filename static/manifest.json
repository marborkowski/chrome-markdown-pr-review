{
  "manifest_version": 3,
  "name": "Markdown PR Review",
  "short_name": "MD Review",
  "version": "1.0.0",
  "description": "Review Markdown files in GitHub & GitHub Enterprise pull requests as rendered documents and comment on selected text.",
  "minimum_chrome_version": "110",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_title": "Markdown PR Review (Alt+Shift+M)",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png"
    }
  },
  "background": {
    "service_worker": "background.js"
  },
  "options_page": "options.html",
  "permissions": ["storage", "scripting"],
  "host_permissions": ["https://github.com/*", "https://api.github.com/*"],
  "optional_host_permissions": ["https://*/*", "http://*/*"],
  "content_scripts": [
    {
      "matches": ["https://github.com/*"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": ["review.js", "mermaid.js", "katex.js"],
      "matches": ["https://*/*", "http://*/*"]
    }
  ],
  "commands": {
    "toggle-review": {
      "suggested_key": { "default": "Alt+Shift+M" },
      "description": "Open / close the Markdown review panel"
    }
  }
}
